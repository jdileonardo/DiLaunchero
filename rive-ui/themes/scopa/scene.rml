                <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fixed"
                                      marginTop="0" marginBottom="0" name="Divider Style" id="1:86"/>
                <!-- band:begin -->
                <Node name="Band">
                    <Shape name="Beads5">
