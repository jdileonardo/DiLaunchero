                        <PointsPath isClosed="true" isClockwise="true" name="P"><StraightVertex x="-8.18" y="-10.91" radius="1.6363636363636362"/><StraightVertex x="8.18" y="-10.91" radius="1.6363636363636362"/><StraightVertex x="7.09" y="-4.36" radius="1.6363636363636362"/><StraightVertex x="3.27" y="0" radius="1.6363636363636362"/><StraightVertex x="-3.27" y="0" radius="1.6363636363636362"/><StraightVertex x="-7.09" y="-4.36" radius="1.6363636363636362"/></PointsPath>
