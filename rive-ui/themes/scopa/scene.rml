                    </Shape>
                    <Shape name="Diamonds4">
                        <Rectangle x="405.4" y="7" rotation="0.7854" width="7" height="7" cornerRadiusTL="1" name="R"/>
                        <Rectangle x="444" y="7" rotation="0.7854" width="7" height="7" cornerRadiusTL="1" name="R"/>
