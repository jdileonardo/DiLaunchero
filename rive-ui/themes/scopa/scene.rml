        <StateMachine name="Tile Machine" id="3:900">
            <StateMachineLayer name="Focus" id="3:901">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="3:910"/></EntryState>
                <AnimationState x="100" y="100" animationId="3:920" stateName="Rest" id="3:910">
                    <StateTransition stateToId="3:911" duration="200" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.2" y1="0.9" x2="0.3" y2="1"/>
                        <TransitionViewModelCondition opValue="equal">
