                    </StateTransition>
                </AnimationState>
                <AnimationState x="300" y="100" animationId="3:921" stateName="Focused" id="3:911">
                    <StateTransition stateToId="3:910" duration="160" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.2" y2="1"/>
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
