                        <Fill name="F"><SolidColor colorValue="FFD92A2F" name="C"/></Fill>
                    </Shape>
                    <Shape name="Diamonds5">
                        <Rectangle x="559.8" y="7" rotation="0.7854" width="7" height="7" cornerRadiusTL="1" name="R"/>
