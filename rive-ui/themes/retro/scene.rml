<Rive version="1" kind="fragment">
    <!-- ================================================================
         Home: the launcher screen, 1920x1080. Bound to the Home view model
         (data.rml); the Android host writes the clock, now playing and the
         two app lists, and sets `focused` on whichever tile has focus.
         ================================================================ -->
    <Artboard defaultStateMachineId="1:900" viewModelId="4:1" viewModelInstanceId="5:1"
              width="1920" height="1080" styleId="1:2" name="Home" id="1:1">
        <LayoutComponentStyle name="Home Style" id="1:2"/>

        <Fill name="Background">
            <LinearGradient startX="0" startY="0" endX="1920" endY="1080" name="BG">
                <GradientStop colorValue="FFF6E9CC" position="0" id="15:1"/>
                <GradientStop colorValue="FFF3E2BF" position="0.55" id="15:2"/>
                <GradientStop colorValue="FFEEDAB3" position="1" id="15:3"/>
            </LinearGradient>
        </Fill>

        <LayoutComponent width="1920" height="1080" clip="false" styleId="1:11" name="Root" id="1:10">
            <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fill"
                                  flexDirectionValue="column"
                                  paddingLeft="72" paddingRight="72" paddingTop="48" paddingBottom="32"
                                  gapVertical="20"
                                  name="Root Style" id="1:11"/>

            <!-- ---------- top bar: clock · now playing · buttons ---------- -->
            <LayoutComponent height="112" clip="false" styleId="1:21" name="TopBar" id="1:20">
                <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fixed"
                                      flexDirectionValue="row" layoutAlignmentType="centerLeft"
                                      gapHorizontal="20" name="TopBar Style" id="1:21"/>
<!-- theme-button:shape begin -->
                <!-- theme button: pinned under the gear; opens the theme picker -->
                <LayoutComponent width="52" height="52" clip="false" styleId="11:2" name="Theme" id="11:1">
                    <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed"
                                          positionTypeValue="absolute"
                                          positionRight="16" positionRightUnitsValue="points"
                                          positionTop="110" positionTopUnitsValue="points"
                                          cornerRadiusTL="26" name="Theme Style" id="11:2"/>
                    <ComponentOrigin originX="0.5" originY="0.5" name="Origin"/>
                    <Node x="26" y="26" name="Icon"><Shape x="-7" y="-5" name="Dot0"><Ellipse width="6" height="6" name="P"/><Fill name="F"><SolidColor colorValue="FFE4572E" name="C"/></Fill></Shape><Shape x="1" y="-8" name="Dot1"><Ellipse width="6" height="6" name="P"/><Fill name="F"><SolidColor colorValue="FFF2B134" name="C"/></Fill></Shape><Shape x="8" y="-3" name="Dot2"><Ellipse width="6" height="6" name="P"/><Fill name="F"><SolidColor colorValue="FF2A9D8F" name="C"/></Fill></Shape><Shape x="7" y="5" name="Dot3"><Ellipse width="6" height="6" name="P"/><Fill name="F"><SolidColor colorValue="FF2B1E16" name="C"/></Fill></Shape><Shape x="-4" y="5" name="Thumb"><Ellipse width="7" height="6" name="P"/><Fill name="F"><SolidColor colorValue="FFFFF8EA" name="C" id="11:7"/></Fill></Shape><Shape name="Palette"><Ellipse width="30" height="24" name="P"/><Fill name="F"><SolidColor colorValue="FFFFF8EA" name="C"/></Fill><Stroke thickness="2.5" name="S"><SolidColor colorValue="FF2B1E16" name="C"/></Stroke></Shape></Node>
                    <LayoutComponent clip="false" styleId="11:5" name="Face"><LayoutComponentStyle widthUnitsValue="auto" heightUnitsValue="auto" positionTypeValue="absolute" positionLeft="0" positionLeftUnitsValue="points" positionTop="0" positionTopUnitsValue="points" positionRight="0" positionRightUnitsValue="points" positionBottom="0" positionBottomUnitsValue="points" cornerRadiusTL="26" name="Face Style" id="11:5"/><Fill name="F"><SolidColor colorValue="FFFFF8EA" name="C" id="11:3"/></Fill><Stroke thickness="4" name="Ring"><SolidColor colorValue="FF2B1E16" name="C" id="11:4"/></Stroke></LayoutComponent>
                    <LayoutComponent clip="false" styleId="11:6" name="Shadow"><LayoutComponentStyle widthUnitsValue="auto" heightUnitsValue="auto" positionTypeValue="absolute" positionLeft="4" positionLeftUnitsValue="points" positionTop="4" positionTopUnitsValue="points" positionRight="-4" positionRightUnitsValue="points" positionBottom="-4" positionBottomUnitsValue="points" cornerRadiusTL="26" name="Shadow Style" id="11:6"/><Fill name="F"><SolidColor colorValue="FF2B1E16" name="C"/></Fill></LayoutComponent>
                </LayoutComponent>
<!-- theme-button:shape end -->

                <LayoutComponent styleId="1:23" name="Clock" id="1:22">
