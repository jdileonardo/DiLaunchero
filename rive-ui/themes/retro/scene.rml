         ================================================================ -->
    <Artboard isComponent="true" defaultStateMachineId="3:900" viewModelId="4:20" viewModelInstanceId="5:200"
              x="2100" width="300" height="250" styleId="3:2" name="FavTile" id="3:1">
        <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed"
                              flexDirectionValue="column" layoutAlignmentType="topCenter"
                              paddingTop="18" gapVertical="20" name="FavTile Style" id="3:2"/>

        <LayoutComponent width="256" height="168" clip="false" styleId="3:11" name="Card" id="3:10">
            <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed"
                                  layoutAlignmentType="center" cornerRadiusTL="32" name="Card Style" id="3:11"/>
            <ComponentOrigin originX="0.5" originY="0.5" name="Origin"/>
            <Fill name="Bg"><SolidColor colorValue="FFFFF8EA" name="C" id="3:12"/></Fill>
            <Stroke thickness="4" name="Ring"><SolidColor colorValue="FF2B1E16" name="C" id="3:14"/></Stroke>
            <Image assetId="6:20" fit="contain" name="Icon" id="3:15">
                <LayoutParticipant layoutWidthScaleType="fixed" layoutHeightScaleType="fixed"
                                   width="112" height="112" name="L"/>
                <DataBindContext sourcePathIds="4:20-4:22" propertyKey="206"/>
            </Image>
