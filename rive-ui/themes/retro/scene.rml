                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="3:910"/></EntryState>
                <AnimationState x="100" y="100" animationId="3:920" stateName="Rest" id="3:910">
