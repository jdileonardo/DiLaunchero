<Rive version="1" kind="fragment">
    <!-- ================================================================
         Home: the launcher screen, 1920x1080. Bound to the Home view model
         (data.rml); the Android host writes the clock, now playing and the
         two app lists, and sets `focused` on whichever tile has focus.
         ================================================================ -->
    <Artboard defaultStateMachineId="1:900" viewModelId="4:1" viewModelInstanceId="5:1"
              width="1920" height="1080" styleId="1:2" name="Home" id="1:1">
        <LayoutComponentStyle name="Home Style" id="1:2"/>

        <Fill name="Background">
            <LinearGradient startX="0" startY="0" endX="0" endY="1080" name="BG">
                <GradientStop colorValue="FF6FB6EA" position="0"/>
                <GradientStop colorValue="FFA6D6F4" position="0.55"/>
                <GradientStop colorValue="FFDDF0F2" position="1"/>
            </LinearGradient>
        </Fill>

        <LayoutComponent width="1920" height="1080" clip="false" styleId="1:11" name="Root" id="1:10">
            <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fill"
                                  flexDirectionValue="column"
                                  paddingLeft="72" paddingRight="72" paddingTop="48" paddingBottom="32"
                                  gapVertical="20"
                                  name="Root Style" id="1:11"/>

            <!-- ---------- top bar: clock · now playing · buttons ---------- -->
            <LayoutComponent height="112" clip="false" styleId="1:21" name="TopBar" id="1:20">
                <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fixed"
                                      flexDirectionValue="row" layoutAlignmentType="centerLeft"
                                      gapHorizontal="20" name="TopBar Style" id="1:21"/>
<!-- theme-button:shape begin -->
                <!-- theme button: pinned under the gear; opens the theme picker -->
                <LayoutComponent width="52" height="52" clip="false" styleId="11:2" name="Theme" id="11:1">
                    <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed"
                                          positionTypeValue="absolute"
                                          positionRight="16" positionRightUnitsValue="points"
                                          positionTop="110" positionTopUnitsValue="points"
                                          cornerRadiusTL="26" name="Theme Style" id="11:2"/>
                    <ComponentOrigin originX="0.5" originY="0.5" name="Origin"/>
                    <Node x="26" y="26" name="Icon"><Shape x="-7" y="-5" name="Dot0"><Ellipse width="6" height="6" name="P"/><Fill name="F"><SolidColor colorValue="FFC0503A" name="C"/></Fill></Shape><Shape x="1" y="-8" name="Dot1"><Ellipse width="6" height="6" name="P"/><Fill name="F"><SolidColor colorValue="FFF4C14F" name="C"/></Fill></Shape><Shape x="8" y="-3" name="Dot2"><Ellipse width="6" height="6" name="P"/><Fill name="F"><SolidColor colorValue="FF6E9B4B" name="C"/></Fill></Shape><Shape x="7" y="5" name="Dot3"><Ellipse width="6" height="6" name="P"/><Fill name="F"><SolidColor colorValue="FF6FB6EA" name="C"/></Fill></Shape><Shape x="-4" y="5" name="Thumb"><Ellipse width="7" height="6" name="P"/><Fill name="F"><SolidColor colorValue="FFFFFAEE" name="C" id="11:7"/></Fill></Shape><Shape name="Palette"><Ellipse width="30" height="24" name="P"/><Fill name="F"><SolidColor colorValue="FFFFFAEE" name="C"/></Fill><Stroke thickness="2.5" name="S"><SolidColor colorValue="FF3B2A1E" name="C"/></Stroke></Shape></Node>
                    <LayoutComponent clip="false" styleId="11:5" name="Face"><LayoutComponentStyle widthUnitsValue="auto" heightUnitsValue="auto" positionTypeValue="absolute" positionLeft="0" positionLeftUnitsValue="points" positionTop="0" positionTopUnitsValue="points" positionRight="0" positionRightUnitsValue="points" positionBottom="0" positionBottomUnitsValue="points" cornerRadiusTL="26" name="Face Style" id="11:5"/><Fill name="F"><SolidColor colorValue="FFFFFAEE" name="C" id="11:3"/></Fill><Stroke thickness="3" name="Ring"><SolidColor colorValue="FF3B2A1E" name="C" id="11:4"/></Stroke></LayoutComponent>
                    <LayoutComponent clip="false" styleId="11:6" name="Shadow"><LayoutComponentStyle widthUnitsValue="auto" heightUnitsValue="auto" positionTypeValue="absolute" positionLeft="4" positionLeftUnitsValue="points" positionTop="4" positionTopUnitsValue="points" positionRight="-4" positionRightUnitsValue="points" positionBottom="-4" positionBottomUnitsValue="points" cornerRadiusTL="26" name="Shadow Style" id="11:6"/><Fill name="F"><SolidColor colorValue="4D2C4A1E" name="C"/></Fill></LayoutComponent>
                </LayoutComponent>
<!-- theme-button:shape end -->

                <LayoutComponent styleId="1:23" name="Clock" id="1:22">
                    <LayoutComponentStyle layoutWidthScaleType="hug" layoutHeightScaleType="hug"
                                          flexDirectionValue="column" gapVertical="2"
                                          name="Clock Style" id="1:23"/>
                    <Text name="Time" id="1:24">
                        <LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="L"/>
                        <TextStylePaint fontSize="68" fontAssetId="6:1" letterSpacing="-1" name="Time Style" id="1:25">
                            <Fill name="F"><SolidColor colorValue="FF3B2A1E" name="C"/></Fill>
                            <TextStyleAxis tag="2003265652" axisValue="600" name="Weight"/>
                        </TextStylePaint>
                        <TextValueRun styleId="1:25" text="11:11 PM" name="Run">
                            <DataBindContext sourcePathIds="4:1-4:2" propertyKey="268"/>
                        </TextValueRun>
                    </Text>
                    <Text name="Date" id="1:26">
                        <LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="L"/>
                        <TextStylePaint fontSize="22" fontAssetId="6:1" name="Date Style" id="1:27">
                            <Fill name="F"><SolidColor colorValue="FF3E5A78" name="C"/></Fill>
                        </TextStylePaint>
                        <TextValueRun styleId="1:27" text="Tuesday, November 17" name="Run">
                            <DataBindContext sourcePathIds="4:1-4:3" propertyKey="268"/>
                        </TextValueRun>
                    </Text>
                </LayoutComponent>

<!-- cast:mascot begin -->
<!-- Owl, reading beside the clock. Blinks on a loop; bobs while something plays -->
                <LayoutComponent width="124" height="112" clip="false" styleId="1:201" name="Mascot" id="1:200">
                    <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed"
                                          marginLeft="18" name="Mascot Style" id="1:201"/>
                    <Node x="62" y="100" name="Bob" id="1:202"><Node x="0" y="-26" name="Book" id="1:204"><Node x="0" y="0" name="Page" id="12:99"><Shape x="0" y="0" name="P"><Rectangle x="11" y="0" width="22" height="26" cornerRadiusTL="2" name="P"/><Fill name="F"><SolidColor colorValue="FFFFFAEE" name="C"/></Fill><Stroke thickness="2" name="S"><SolidColor colorValue="FF3B2A1E" name="C"/></Stroke></Shape></Node><Shape x="0" y="0" name="Pages"><Rectangle x="-11" y="0" width="22" height="26" cornerRadiusTL="2" name="P"/><Rectangle x="11" y="0" width="22" height="26" cornerRadiusTL="2" name="P"/><Fill name="F"><SolidColor colorValue="FFFFFAEE" name="C"/></Fill><Stroke thickness="2" name="S"><SolidColor colorValue="FF3B2A1E" name="C"/></Stroke></Shape><Shape x="0" y="0" name="Lines"><Rectangle x="-11" y="-6" width="14" height="2" name="P"/><Rectangle x="-11" y="0" width="14" height="2" name="P"/><Rectangle x="-11" y="6" width="14" height="2" name="P"/><Rectangle x="11" y="-6" width="14" height="2" name="P"/><Rectangle x="11" y="0" width="14" height="2" name="P"/><Fill name="F"><SolidColor colorValue="FFB8A688" name="C"/></Fill></Shape><Shape x="0" y="0" name="Cover"><Rectangle x="0" y="2" width="52" height="30" cornerRadiusTL="3" name="P"/><Fill name="F"><SolidColor colorValue="FFC0503A" name="C"/></Fill><Stroke thickness="2.5" name="S"><SolidColor colorValue="FF3B2A1E" name="C"/></Stroke></Shape></Node><Node x="0" y="-64" name="Eyes" id="1:203"><Shape x="0" y="0" name="Glints"><Ellipse x="-10" y="-3" width="4" height="4" name="P"/><Ellipse x="14" y="-3" width="4" height="4" name="P"/><Fill name="F"><SolidColor colorValue="FFFFFAEE" name="C"/></Fill></Shape><Shape x="0" y="0" name="Pupils"><Ellipse x="-12" y="0" width="11" height="12" name="P"/><Ellipse x="12" y="0" width="11" height="12" name="P"/><Fill name="F"><SolidColor colorValue="FF3B2A1E" name="C"/></Fill></Shape></Node><Shape x="0" y="0" name="Whites"><Ellipse x="-12" y="-64" width="26" height="26" name="P"/><Ellipse x="12" y="-64" width="26" height="26" name="P"/><Fill name="F"><SolidColor colorValue="FFFFFAEE" name="C"/></Fill><Stroke thickness="2.5" name="S"><SolidColor colorValue="FF3B2A1E" name="C"/></Stroke></Shape><Shape x="0" y="0" name="Beak"><Triangle x="0" y="-50" width="11" height="13" rotation="3.14" name="P"/><Fill name="F"><SolidColor colorValue="FFF4C14F" name="C"/></Fill><Stroke thickness="2" name="S"><SolidColor colorValue="FF3B2A1E" name="C"/></Stroke></Shape><Shape x="0" y="0" name="WingL"><Ellipse x="-34" y="-34" width="22" height="48" rotation="0.25" name="P"/><Fill name="F"><SolidColor colorValue="FF6E4E31" name="C"/></Fill><Stroke thickness="2.5" name="S"><SolidColor colorValue="FF3B2A1E" name="C"/></Stroke></Shape><Shape x="0" y="0" name="WingR"><Ellipse x="34" y="-34" width="22" height="48" rotation="-0.25" name="P"/><Fill name="F"><SolidColor colorValue="FF6E4E31" name="C"/></Fill><Stroke thickness="2.5" name="S"><SolidColor colorValue="FF3B2A1E" name="C"/></Stroke></Shape><Shape x="0" y="0" name="FaceDisc"><Ellipse x="0" y="-62" width="64" height="44" name="P"/><Fill name="F"><SolidColor colorValue="FFEBD3A8" name="C"/></Fill><Stroke thickness="2.5" name="S"><SolidColor colorValue="FF3B2A1E" name="C"/></Stroke></Shape><Shape x="0" y="0" name="Belly"><Ellipse x="0" y="-28" width="42" height="50" name="P"/><Fill name="F"><SolidColor colorValue="FFEBD3A8" name="C"/></Fill></Shape><Shape x="0" y="0" name="Body"><Ellipse x="0" y="-44" width="74" height="92" name="P"/><Fill name="F"><SolidColor colorValue="FF8A6440" name="C"/></Fill><Stroke thickness="3" name="S"><SolidColor colorValue="FF3B2A1E" name="C"/></Stroke></Shape><Shape x="0" y="0" name="Tufts"><Triangle x="-26" y="-92" width="16" height="24" rotation="-0.4" name="P"/><Triangle x="26" y="-92" width="16" height="24" rotation="0.4" name="P"/><Fill name="F"><SolidColor colorValue="FF8A6440" name="C"/></Fill><Stroke thickness="3" name="S"><SolidColor colorValue="FF3B2A1E" name="C"/></Stroke></Shape><Shape x="0" y="0" name="Feet"><Ellipse x="-12" y="0" width="12" height="8" name="P"/><Ellipse x="12" y="0" width="12" height="8" name="P"/><Fill name="F"><SolidColor colorValue="FFF4C14F" name="C"/></Fill><Stroke thickness="2" name="S"><SolidColor colorValue="FF3B2A1E" name="C"/></Stroke></Shape></Node>
                </LayoutComponent>
<!-- cast:mascot end -->

                <!-- takes the slack, pushing the rest right -->
                <LayoutComponent height="10" styleId="1:29" name="Spacer" id="1:28">
                    <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fixed"
                                          name="Spacer Style" id="1:29"/>
                </LayoutComponent>

                <!-- now playing card -->
                <LayoutComponent height="96" clip="false" styleId="1:31" name="NowPlaying" id="1:30">
                    <LayoutComponentStyle layoutWidthScaleType="hug" layoutHeightScaleType="fixed"
                                          flexDirectionValue="row" layoutAlignmentType="centerLeft"
                                          paddingLeft="10" paddingRight="14" gapHorizontal="18"
                                          cornerRadiusTL="28" name="NowPlaying Style" id="1:31"/>

                    <LayoutComponent width="76" height="76" clip="true" styleId="1:33" name="ArtFrame" id="1:32">
                        <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed"
                                              cornerRadiusTL="18" name="ArtFrame Style" id="1:33"/>
                        <Image assetId="6:2" fit="cover" name="Art" id="1:34">
                            <LayoutParticipant layoutWidthScaleType="fill" layoutHeightScaleType="fill" name="L"/>
                            <DataBindContext sourcePathIds="4:1-4:6" propertyKey="206"/>
                        </Image>
                    </LayoutComponent>

                    <LayoutComponent styleId="1:36" name="Meta" id="1:35">
                        <LayoutComponentStyle layoutWidthScaleType="hug" layoutHeightScaleType="hug"
                                              flexDirectionValue="column" gapVertical="4"
                                              name="Meta Style" id="1:36"/>
                        <Text name="Title" id="1:37">
                            <LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="L"/>
                            <TextStylePaint fontSize="24" fontAssetId="6:1" name="Title Style" id="1:38">
                                <Fill name="F"><SolidColor colorValue="FF3B2A1E" name="C"/></Fill>
                                <TextStyleAxis tag="2003265652" axisValue="600" name="Weight"/>
                            </TextStylePaint>
                            <TextValueRun styleId="1:38" text="Slide" name="Run">
                                <DataBindContext sourcePathIds="4:1-4:4" propertyKey="268"/>
                            </TextValueRun>
                        </Text>
                        <Text name="Subtitle" id="1:39">
                            <LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="L"/>
                            <TextStylePaint fontSize="17" fontAssetId="6:1" name="Subtitle Style" id="1:40">
                                <Fill name="F"><SolidColor colorValue="FF3E5A78" name="C"/></Fill>
                            </TextStylePaint>
                            <TextValueRun styleId="1:40" text="The Meadow Band · Spotify" name="Run">
                                <DataBindContext sourcePathIds="4:1-4:5" propertyKey="268"/>
                            </TextValueRun>
                        </Text>
                    </LayoutComponent>

                    <!-- transport: prev · play/pause · next -->
                    <LayoutComponent styleId="1:42" name="Transport" id="1:41">
                        <LayoutComponentStyle layoutWidthScaleType="hug" layoutHeightScaleType="hug"
                                              flexDirectionValue="row" layoutAlignmentType="centerLeft"
                                              gapHorizontal="6" name="Transport Style" id="1:42"/>
                        <LayoutComponent width="56" height="56" styleId="1:44" name="Prev" id="1:43">
                            <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed"
                                                  cornerRadiusTL="28" name="Prev Style" id="1:44"/>
                            <ComponentOrigin originX="0.5" originY="0.5" name="Origin"/>
                            <Stroke thickness="3" name="Ring"><SolidColor colorValue="00FFFFFF" name="C" id="1:244"/></Stroke>
                            <Fill name="F"><SolidColor colorValue="00FFFFFF" name="C" id="1:344"/></Fill>
                            <Node name="Icon">
                                <Shape x="28" y="28" name="Glyph">
                                    <Rectangle x="-9" y="0" width="3.5" height="18" name="Bar"/>
