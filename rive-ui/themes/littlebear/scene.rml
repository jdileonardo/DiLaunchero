                                <Fill name="F"><SolidColor colorValue="FFC0503A" name="C" id="1:445"/></Fill><Stroke thickness="3" name="Edge"><SolidColor colorValue="FF3B2A1E" name="C"/></Stroke><Stroke thickness="6" name="Ring"><SolidColor colorValue="00FFFFFF" name="C" id="1:246"/></Stroke>
                            </LayoutComponent>
                            <LayoutComponent clip="false" styleId="1:453" name="Shadow">
