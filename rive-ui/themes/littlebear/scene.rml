                                    <Fill name="F"><SolidColor colorValue="FFFFFAEE" name="C"/></Fill>
                                </Shape>
                            </Node>
                            <LayoutComponent clip="false" styleId="1:451" name="Face">
                                <LayoutComponentStyle widthUnitsValue="auto" heightUnitsValue="auto"
