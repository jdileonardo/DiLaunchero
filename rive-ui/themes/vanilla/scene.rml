<Rive version="1" kind="fragment">
    <!-- ================================================================
         Home: the launcher screen, 1920x1080. Bound to the Home view model
         (data.rml); the Android host writes the clock, now playing and the
         two app lists, and sets `focused` on whichever tile has focus.
         ================================================================ -->
    <Artboard defaultStateMachineId="1:900" viewModelId="4:1" viewModelInstanceId="5:1"
              width="1920" height="1080" styleId="1:2" name="Home" id="1:1">
        <LayoutComponentStyle name="Home Style" id="1:2"/>

        <Fill name="Background">
            <LinearGradient startX="0" startY="0" endX="1920" endY="1080" name="BG">
                <GradientStop colorValue="FF0A0F1C" position="0"/>
                <GradientStop colorValue="FF121A2C" position="0.55"/>
                <GradientStop colorValue="FF0B101D" position="1"/>
            </LinearGradient>
        </Fill>

        <LayoutComponent width="1920" height="1080" clip="false" styleId="1:11" name="Root" id="1:10">
            <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fill"
                                  flexDirectionValue="column"
                                  paddingLeft="72" paddingRight="72" paddingTop="48" paddingBottom="32"
                                  gapVertical="20"
                                  name="Root Style" id="1:11"/>

            <!-- ---------- top bar: clock · now playing · buttons ---------- -->
            <LayoutComponent height="112" clip="false" styleId="1:21" name="TopBar" id="1:20">
                <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fixed"
                                      flexDirectionValue="row" layoutAlignmentType="centerLeft"
                                      gapHorizontal="20" name="TopBar Style" id="1:21"/>
<!-- theme-button:shape begin -->
                <!-- theme button: pinned under the gear; opens the theme picker -->
                <LayoutComponent width="52" height="52" clip="false" styleId="11:2" name="Theme" id="11:1">
                    <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed"
                                          positionTypeValue="absolute"
                                          positionRight="16" positionRightUnitsValue="points"
                                          positionTop="110" positionTopUnitsValue="points"
                                          cornerRadiusTL="26" name="Theme Style" id="11:2"/>
                    <ComponentOrigin originX="0.5" originY="0.5" name="Origin"/>
                    <Node x="26" y="26" name="Icon"><Shape x="-7" y="-5" name="Dot0"><Ellipse width="6" height="6" name="P"/><Fill name="F"><SolidColor colorValue="FFFF7A6B" name="C"/></Fill></Shape><Shape x="1" y="-8" name="Dot1"><Ellipse width="6" height="6" name="P"/><Fill name="F"><SolidColor colorValue="FFFFD66B" name="C"/></Fill></Shape><Shape x="8" y="-3" name="Dot2"><Ellipse width="6" height="6" name="P"/><Fill name="F"><SolidColor colorValue="FF6FD3C2" name="C"/></Fill></Shape><Shape x="7" y="5" name="Dot3"><Ellipse width="6" height="6" name="P"/><Fill name="F"><SolidColor colorValue="FF6F9BFF" name="C"/></Fill></Shape><Shape x="-4" y="5" name="Thumb"><Ellipse width="7" height="6" name="P"/><Fill name="F"><SolidColor colorValue="FF1A2336" name="C" id="11:7"/></Fill></Shape><Shape name="Palette"><Ellipse width="30" height="24" name="P"/><Fill name="F"><SolidColor colorValue="FFDCE3F0" name="C"/></Fill></Shape></Node>
                    <LayoutComponent clip="false" styleId="11:5" name="Face"><LayoutComponentStyle widthUnitsValue="auto" heightUnitsValue="auto" positionTypeValue="absolute" positionLeft="0" positionLeftUnitsValue="points" positionTop="0" positionTopUnitsValue="points" positionRight="0" positionRightUnitsValue="points" positionBottom="0" positionBottomUnitsValue="points" cornerRadiusTL="26" name="Face Style" id="11:5"/><Fill name="F"><SolidColor colorValue="FF1A2336" name="C" id="11:3"/></Fill><Stroke thickness="3" name="Ring"><SolidColor colorValue="00FFFFFF" name="C" id="11:4"/></Stroke></LayoutComponent>
                    
                </LayoutComponent>
<!-- theme-button:shape end -->

                <LayoutComponent styleId="1:23" name="Clock" id="1:22">
                    <LayoutComponentStyle layoutWidthScaleType="hug" layoutHeightScaleType="hug"
                                          flexDirectionValue="column" gapVertical="2"
                                          name="Clock Style" id="1:23"/>
                    <Text name="Time" id="1:24">
                        <LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="L"/>
                        <TextStylePaint fontSize="68" fontAssetId="6:1" letterSpacing="-1" name="Time Style" id="1:25">
                            <Fill name="F"><SolidColor colorValue="FFF4F6FB" name="C"/></Fill>
                            <TextStyleAxis tag="2003265652" axisValue="300" name="Weight"/>
                        </TextStylePaint>
                        <TextValueRun styleId="1:25" text="11:11 PM" name="Run">
                            <DataBindContext sourcePathIds="4:1-4:2" propertyKey="268"/>
                        </TextValueRun>
                    </Text>
                    <Text name="Date" id="1:26">
                        <LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="L"/>
                        <TextStylePaint fontSize="22" fontAssetId="6:1" name="Date Style" id="1:27">
                            <Fill name="F"><SolidColor colorValue="FF8E99AD" name="C"/></Fill>
                        </TextStylePaint>
                        <TextValueRun styleId="1:27" text="Tuesday, November 17" name="Run">
                            <DataBindContext sourcePathIds="4:1-4:3" propertyKey="268"/>
                        </TextValueRun>
                    </Text>
                </LayoutComponent>

                <!-- takes the slack, pushing the rest right -->
                <LayoutComponent height="10" styleId="1:29" name="Spacer" id="1:28">
                    <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fixed"
                                          name="Spacer Style" id="1:29"/>
                </LayoutComponent>

                <!-- now playing card -->
                <LayoutComponent height="96" clip="false" styleId="1:31" name="NowPlaying" id="1:30">
                    <LayoutComponentStyle layoutWidthScaleType="hug" layoutHeightScaleType="fixed"
                                          flexDirectionValue="row" layoutAlignmentType="centerLeft"
                                          paddingLeft="10" paddingRight="14" gapHorizontal="18"
                                          cornerRadiusTL="28" name="NowPlaying Style" id="1:31"/>
                    <Fill name="F"><SolidColor colorValue="CC1A2336" name="C"/></Fill>
                    <Stroke thickness="1" name="Edge"><SolidColor colorValue="22FFFFFF" name="C"/></Stroke>

                    <LayoutComponent width="76" height="76" clip="true" styleId="1:33" name="ArtFrame" id="1:32">
                        <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed"
                                              cornerRadiusTL="18" name="ArtFrame Style" id="1:33"/>
                        <Image assetId="6:2" fit="cover" name="Art" id="1:34">
                            <LayoutParticipant layoutWidthScaleType="fill" layoutHeightScaleType="fill" name="L"/>
                            <DataBindContext sourcePathIds="4:1-4:6" propertyKey="206"/>
                        </Image>
                    </LayoutComponent>

                    <LayoutComponent styleId="1:36" name="Meta" id="1:35">
                        <LayoutComponentStyle layoutWidthScaleType="hug" layoutHeightScaleType="hug"
                                              flexDirectionValue="column" gapVertical="4"
                                              name="Meta Style" id="1:36"/>
                        <Text name="Title" id="1:37">
                            <LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="L"/>
                            <TextStylePaint fontSize="24" fontAssetId="6:1" name="Title Style" id="1:38">
                                <Fill name="F"><SolidColor colorValue="FFF4F6FB" name="C"/></Fill>
                                <TextStyleAxis tag="2003265652" axisValue="600" name="Weight"/>
                            </TextStylePaint>
                            <TextValueRun styleId="1:38" text="Slide" name="Run">
                                <DataBindContext sourcePathIds="4:1-4:4" propertyKey="268"/>
                            </TextValueRun>
                        </Text>
                        <Text name="Subtitle" id="1:39">
                            <LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="L"/>
                            <TextStylePaint fontSize="17" fontAssetId="6:1" name="Subtitle Style" id="1:40">
                                <Fill name="F"><SolidColor colorValue="FF8E99AD" name="C"/></Fill>
                            </TextStylePaint>
                            <TextValueRun styleId="1:40" text="The Meadow Band · Spotify" name="Run">
                                <DataBindContext sourcePathIds="4:1-4:5" propertyKey="268"/>
                            </TextValueRun>
                        </Text>
                    </LayoutComponent>

                    <!-- transport: prev · play/pause · next -->
                    <LayoutComponent styleId="1:42" name="Transport" id="1:41">
                        <LayoutComponentStyle layoutWidthScaleType="hug" layoutHeightScaleType="hug"
                                              flexDirectionValue="row" layoutAlignmentType="centerLeft"
                                              gapHorizontal="6" name="Transport Style" id="1:42"/>
                        <LayoutComponent width="56" height="56" styleId="1:44" name="Prev" id="1:43">
                            <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed"
                                                  cornerRadiusTL="28" name="Prev Style" id="1:44"/>
                            <ComponentOrigin originX="0.5" originY="0.5" name="Origin"/>
                            <Stroke thickness="3" name="Ring"><SolidColor colorValue="00FFFFFF" name="C" id="1:244"/></Stroke>
                            <Fill name="F"><SolidColor colorValue="00FFFFFF" name="C" id="1:344"/></Fill>
                            <Node name="Icon">
                                <Shape x="28" y="28" name="Glyph">
                                    <Rectangle x="-9" y="0" width="3.5" height="18" name="Bar"/>
                                    <Triangle x="2" y="0" rotation="-1.5707964" width="18" height="16" name="Tri"/>
                                    <Fill name="F"><SolidColor colorValue="FFDCE3F0" name="C"/></Fill>
                                </Shape>
                            </Node>
                        </LayoutComponent>
                        <LayoutComponent width="56" height="56" styleId="1:46" name="PlayPause" id="1:45">
                            <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed"
                                                  cornerRadiusTL="28" name="PlayPause Style" id="1:46"/>
                            <ComponentOrigin originX="0.5" originY="0.5" name="Origin"/>
                            <Fill name="F"><SolidColor colorValue="FFF4F6FB" name="C"/></Fill>
                            <Stroke thickness="4" name="Ring"><SolidColor colorValue="00FFFFFF" name="C" id="1:246"/></Stroke>
                            <Node name="Icon">
                                <!-- pause bars; the play triangle swaps in when npPlaying is false -->
                                <Shape x="28" y="28" name="Pause" id="1:47">
                                    <Rectangle x="-5" y="0" width="5" height="18" cornerRadiusTL="1.5" name="L"/>
                                    <Rectangle x="5" y="0" width="5" height="18" cornerRadiusTL="1.5" name="R"/>
                                    <Fill name="F"><SolidColor colorValue="FF101626" name="C"/></Fill>
                                </Shape>
                                <Shape x="30" y="28" opacity="0" name="Play" id="1:48">
                                    <Triangle rotation="1.5707964" width="20" height="18" name="Tri"/>
                                    <Fill name="F"><SolidColor colorValue="FF101626" name="C"/></Fill>
                                </Shape>
                            </Node>
                        </LayoutComponent>
                        <LayoutComponent width="56" height="56" styleId="1:50" name="Next" id="1:49">
                            <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed"
                                                  cornerRadiusTL="28" name="Next Style" id="1:50"/>
                            <ComponentOrigin originX="0.5" originY="0.5" name="Origin"/>
                            <Stroke thickness="3" name="Ring"><SolidColor colorValue="00FFFFFF" name="C" id="1:250"/></Stroke>
                            <Fill name="F"><SolidColor colorValue="00FFFFFF" name="C" id="1:350"/></Fill>
                            <Node name="Icon">
                                <Shape x="28" y="28" name="Glyph">
                                    <Rectangle x="9" y="0" width="3.5" height="18" name="Bar"/>
                                    <Triangle x="-2" y="0" rotation="1.5707964" width="18" height="16" name="Tri"/>
                                    <Fill name="F"><SolidColor colorValue="FFDCE3F0" name="C"/></Fill>
                                </Shape>
                            </Node>
                        </LayoutComponent>
                    </LayoutComponent>
                </LayoutComponent>

                <!-- screensaver button -->
                <LayoutComponent width="84" height="84" clip="false" styleId="1:61" name="Screensaver" id="1:60">
                    <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed"
                                          cornerRadiusTL="42" name="Screensaver Style" id="1:61"/>
                    <ComponentOrigin originX="0.5" originY="0.5" name="Origin"/>
                    <Fill name="F"><SolidColor colorValue="FF1A2336" name="C" id="1:62"/></Fill>
                    <Stroke thickness="3" name="Ring"><SolidColor colorValue="00FFFFFF" name="C" id="1:63"/></Stroke>
                    <Node name="Icon">
                        <Shape x="42" y="40" name="Monitor">
                            <Rectangle width="40" height="27" cornerRadiusTL="5" name="Screen"/>
                            <Stroke thickness="3" name="S"><SolidColor colorValue="FFDCE3F0" name="C"/></Stroke>
                        </Shape>
                        <Shape x="42" y="60" name="Stand">
                            <Rectangle width="18" height="3" cornerRadiusTL="1.5" name="Base"/>
                            <Rectangle y="-4" width="3" height="6" name="Neck"/>
                            <Fill name="F"><SolidColor colorValue="FFDCE3F0" name="C"/></Fill>
                        </Shape>
                        <Shape x="50" y="35" name="Sun">
                            <Ellipse width="9" height="9" name="P"/>
                            <Fill name="F"><SolidColor colorValue="FFFFD66B" name="C"/></Fill>
                        </Shape>
                    </Node>
                </LayoutComponent>

                <!-- settings button -->
                <LayoutComponent width="84" height="84" clip="false" styleId="1:71" name="Settings" id="1:70">
                    <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed"
                                          cornerRadiusTL="42" name="Settings Style" id="1:71"/>
                    <ComponentOrigin originX="0.5" originY="0.5" name="Origin"/>
                    <Fill name="F"><SolidColor colorValue="FF1A2336" name="C" id="1:72"/></Fill>
                    <Stroke thickness="3" name="Ring"><SolidColor colorValue="00FFFFFF" name="C" id="1:73"/></Stroke>
                    <Node name="Icon">
                        <Shape x="42" y="42" name="Hub">
                            <Ellipse width="11" height="11" name="P"/>
                            <Fill name="F"><SolidColor colorValue="FF1A2336" name="C"/></Fill>
                        </Shape>
                        <Shape x="42" y="42" name="Gear">
                            <Star points="8" width="40" height="40" innerRadius="0.72" cornerRadius="2" name="Teeth"/>
                            <Fill name="F"><SolidColor colorValue="FFDCE3F0" name="C"/></Fill>
                        </Shape>
                    </Node>
                </LayoutComponent>
            </LayoutComponent>

            <!-- ---------- favourites ---------- -->
            <LayoutComponent styleId="1:81" name="Favourites" id="1:80">
                <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="hug"
                                      flexDirectionValue="row" layoutAlignmentType="topCenter"
                                      paddingTop="18" gapHorizontal="8" name="Favourites Style" id="1:81"/>
                <ArtboardComponentList name="FavList" id="1:82">
                    <DataBindContext sourcePathIds="4:1-4:8" propertyKey="800"/>
                </ArtboardComponentList>
            </LayoutComponent>

            <!-- ---------- divider ---------- -->
            <LayoutComponent height="2" styleId="1:86" name="Divider" id="1:85">
                <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fixed"
                                      marginTop="4" marginBottom="8" name="Divider Style" id="1:86"/>
                <Fill name="F">
                    <LinearGradient startX="0" startY="0" endX="1776" endY="0" name="G">
                        <GradientStop colorValue="00334566" position="0"/>
                        <GradientStop colorValue="FF334566" position="0.5"/>
                        <GradientStop colorValue="00334566" position="1"/>
                    </LinearGradient>
                </Fill>
            </LayoutComponent>

            <!-- ---------- all apps: a clipped window over an 8-column grid ----------
                 The host scrolls by setting appsScroll (points, <= 0); the bind eases
                 the grid's y to it. Rows are 182pt (the AppTile artboard height). -->
            <LayoutComponent clip="true" styleId="1:121" name="AppsViewport" id="1:120">
                <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fill"
                                      flexDirectionValue="column" name="AppsViewport Style" id="1:121"/>

                <!-- fade at the bottom edge while more rows sit below; declared first so it draws on top -->
                <LayoutComponent height="90" opacity="0" styleId="1:123" name="MoreFade" id="1:122">
                    <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fixed"
                                          positionTypeValue="absolute"
                                          positionLeft="0" positionLeftUnitsValue="points"
                                          positionRight="0" positionRightUnitsValue="points"
                                          positionBottom="0" positionBottomUnitsValue="points"
                                          name="MoreFade Style" id="1:123"/>
                    <Fill name="F">
                        <LinearGradient startX="0" startY="0" endX="0" endY="90" name="G">
                            <GradientStop colorValue="000C111E" position="0"/>
                            <GradientStop colorValue="F00C111E" position="1"/>
                        </LinearGradient>
                    </Fill>
                </LayoutComponent>

            <LayoutComponent styleId="1:91" name="Apps" id="1:90">
                <LayoutComponentStyle layoutTypeValue="grid"
                                      layoutWidthScaleType="fill" layoutHeightScaleType="hug"
                                      name="Apps Style" id="1:91"/>
                <DataBindContext sourcePathIds="4:1-4:38" propertyKey="14" converterId="7:1"/>
                <GridTrack collection="template-columns" trackType="fr" trackValue="1" name="C1"/>
                <GridTrack collection="template-columns" trackType="fr" trackValue="1" name="C2"/>
                <GridTrack collection="template-columns" trackType="fr" trackValue="1" name="C3"/>
                <GridTrack collection="template-columns" trackType="fr" trackValue="1" name="C4"/>
                <GridTrack collection="template-columns" trackType="fr" trackValue="1" name="C5"/>
                <GridTrack collection="template-columns" trackType="fr" trackValue="1" name="C6"/>
                <GridTrack collection="template-columns" trackType="fr" trackValue="1" name="C7"/>
                <GridTrack collection="template-columns" trackType="fr" trackValue="1" name="C8"/>
                <GridTrack collection="auto-rows" trackType="auto" name="Rows"/>
                <ArtboardComponentList name="AppList" id="1:92">
                    <DataBindContext sourcePathIds="4:1-4:9" propertyKey="800"/>
                </ArtboardComponentList>
            </LayoutComponent>
            </LayoutComponent>
        </LayoutComponent>

        <!-- soft light behind the top-right corner; declared last so it draws underneath -->
        <Shape x="1500" y="40" name="Glow">
            <Ellipse width="2000" height="2000" name="P"/>
            <Fill name="F">
                <RadialGradient startX="0" startY="0" endX="1000" endY="0" name="G">
                    <GradientStop colorValue="2E4A6CFF" position="0"/>
                    <GradientStop colorValue="124A6CFF" position="0.5"/>
                    <GradientStop colorValue="004A6CFF" position="1"/>
                </RadialGradient>
            </Fill>
        </Shape>

        <StateMachine name="Home Machine" id="1:900">
            <StateMachineLayer name="Idle" id="1:901">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="1:910"/></EntryState>
                <AnimationState x="200" animationId="1:920" id="1:910"/>
            </StateMachineLayer>
            <StateMachineLayer name="Screensaver Focus" id="1:1010">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="1:1011"/></EntryState>
                <AnimationState x="100" y="100" animationId="1:1510" stateName="Off" id="1:1011">
                    <StateTransition stateToId="1:1012" duration="160" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.2" y1="0.9" x2="0.3" y2="1"/>
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="4:1-4:30" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="300" y="100" animationId="1:1511" stateName="On" id="1:1012">
                    <StateTransition stateToId="1:1011" duration="140" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.2" y2="1"/>
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="4:1-4:30" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="false"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>
<!-- theme-button:layer begin -->
<StateMachineLayer name="Theme Focus" id="11:20"><AnyState x="200" y="-120"/><ExitState x="400" y="-120"/><EntryState><StateTransition stateToId="11:21"/></EntryState><AnimationState x="100" y="100" animationId="11:10" stateName="Off" id="11:21"><StateTransition stateToId="11:22" duration="160" interpolationType="cubic"><CubicEaseInterpolator x1="0.2" y1="0.9" x2="0.3" y2="1"/><TransitionViewModelCondition opValue="equal"><TransitionPropertyViewModelComparator><BindablePropertyBoolean><DataBindContext sourcePathIds="4:1-4:40" propertyKey="634"/></BindablePropertyBoolean></TransitionPropertyViewModelComparator><TransitionValueBooleanComparator value="true"/></TransitionViewModelCondition></StateTransition></AnimationState><AnimationState x="300" y="100" animationId="11:11" stateName="On" id="11:22"><StateTransition stateToId="11:21" duration="140" interpolationType="cubic"><CubicEaseInterpolator x1="0.4" y1="0" x2="0.2" y2="1"/><TransitionViewModelCondition opValue="equal"><TransitionPropertyViewModelComparator><BindablePropertyBoolean><DataBindContext sourcePathIds="4:1-4:40" propertyKey="634"/></BindablePropertyBoolean></TransitionPropertyViewModelComparator><TransitionValueBooleanComparator value="false"/></TransitionViewModelCondition></StateTransition></AnimationState></StateMachineLayer>
<!-- theme-button:layer end -->
            <StateMachineLayer name="Settings Focus" id="1:1020">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="1:1021"/></EntryState>
                <AnimationState x="100" y="100" animationId="1:1520" stateName="Off" id="1:1021">
                    <StateTransition stateToId="1:1022" duration="160" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.2" y1="0.9" x2="0.3" y2="1"/>
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="4:1-4:31" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="300" y="100" animationId="1:1521" stateName="On" id="1:1022">
                    <StateTransition stateToId="1:1021" duration="140" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.2" y2="1"/>
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="4:1-4:31" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="false"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>
            <StateMachineLayer name="Prev Focus" id="1:1030">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="1:1031"/></EntryState>
                <AnimationState x="100" y="100" animationId="1:1530" stateName="Off" id="1:1031">
                    <StateTransition stateToId="1:1032" duration="160" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.2" y1="0.9" x2="0.3" y2="1"/>
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="4:1-4:34" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="300" y="100" animationId="1:1531" stateName="On" id="1:1032">
                    <StateTransition stateToId="1:1031" duration="140" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.2" y2="1"/>
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="4:1-4:34" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="false"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>
            <StateMachineLayer name="Play Focus" id="1:1040">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="1:1041"/></EntryState>
                <AnimationState x="100" y="100" animationId="1:1540" stateName="Off" id="1:1041">
                    <StateTransition stateToId="1:1042" duration="160" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.2" y1="0.9" x2="0.3" y2="1"/>
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="4:1-4:35" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
